# NeuroScan backend environment — copy to .env (local) or set in Render.
# All values are optional; defaults shown are what the app uses when unset.

# Server bind (Render supplies its own public port; only override locally)
NEUROSCAN_HOST=127.0.0.1
NEUROSCAN_PORT=8000

# Model artifact paths (defaults: backend/models/... resolved from the app dir)
# NEUROSCAN_MODEL_PATH=models/neuroscan_cnn_bilstm_attention.keras
# NEUROSCAN_METRICS_PATH=models/evaluation_metrics.json

# Comma-separated list of allowed browser origins.
# Local dev: http://localhost:5173,http://127.0.0.1:5173
# Deployed:  https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173
